NODE_ENV=development
PORT=8787
HOST=127.0.0.1
# Use HOST=0.0.0.0 on most API hosting platforms.
FRONTEND_ORIGIN=http://localhost:5173
# Use comma-separated origins when deploying frontend previews/production.
# FRONTEND_ORIGIN=http://localhost:5173,https://your-frontend.example.com

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by connected smoke tests, not by the server itself.
SUPABASE_ANON_KEY=your-public-anon-key
# Optional connected smoke controls.
# SMOKE_KEEP_USER=true
# SMOKE_DELETE_USER=false

GEMINI_API_KEY=your-gemini-api-key
GEMINI_PIPELINE_MODEL=gemini-3.1-flash-lite
AI_DAILY_REQUEST_LIMIT=40

# Required for protected operational diagnostics in production.
OPS_TOKEN=replace-with-at-least-16-random-characters
